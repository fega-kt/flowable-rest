# File này là tài liệu tham chiếu cho secrets cần lưu trong Vault.
# KHÔNG dùng file này trực tiếp ở production.
#
# Cách deploy:
#   1. Copy .vault.json.example → .vault.json rồi điền địa chỉ Vault + path
#   2. Lưu các key dưới đây vào Vault tại path "envs.production" trong .vault.json
#   3. Chạy: bash up.sh   (script tự fetch từ Vault, ghi .env, rồi docker compose up)
#
# Lưu vào Vault (vault kv put secret/flowable-server-prod key=value ...):

# Supabase Database
# Lấy từ: Supabase Dashboard → Settings → Database → Connection string (URI)
SUPABASE_DB_URL=jdbc:postgresql://db.[PROJECT_REF].supabase.co:5432/zhizhu?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Flowable Admin (dùng để gọi REST API từ NestJS)
FLOWABLE_ADMIN_USER=admin
FLOWABLE_ADMIN_PASSWORD=your-secure-password
FLOWABLE_ADMIN_EMAIL=admin@example.com

# Shared secret Flowable ↔ NestJS (header X-Internal-Auth)
# Sinh bằng: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=your-random-secret-here

# URL NestJS internal API (chỉ accessible trong mạng nội bộ)
# Docker Compose: http://nestjs:3000
# K8s: http://nestjs-approval-svc:3000
NESTJS_INTERNAL_BASE_URL=http://nestjs:3000
